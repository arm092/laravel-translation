{
    "name": "arm092/laravel-translation",
    "description": "A tool for managing all of your Laravel 10+ translations",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Arm092",
            "email": "arman.khachatryan@apricode.am"
        }
    ],
    "require": {
        "php": "^8.1",
        "illuminate/support": "^10.0||^11.0||^12.0||^13.0",
        "nikic/php-parser": "^5.0"
    },
    "require-dev": {
        "larastan/larastan": "^2.9||^3.0",
        "laravel/pint": "^1.18.1",
        "mockery/mockery": "^1.6.10",
        "orchestra/testbench": "^8.0||^9.0||^10.0||^11.0",
        "phpstan/phpstan": "^1.12||^2.1",
        "phpunit/phpunit": "^10.5.62||^11.5.50||^12.5.8||^13.0.3"
    },
    "suggest": {
        "livewire/livewire": "Install ^4.0 to use the optional Livewire inline translation editor"
    },
    "autoload": {
        "psr-4": {
            "Arm092\\Translation\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Arm092\\Translation\\Tests\\": "tests"
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit",
        "test-coverage": "vendor/bin/phpunit --coverage-html coverage",
        "analyse": "vendor/bin/phpstan analyse --memory-limit=1G",
        "format-check": "vendor/bin/pint --test"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Arm092\\Translation\\TranslationServiceProvider",
                "Arm092\\Translation\\TranslationBindingsServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true
    }
}
