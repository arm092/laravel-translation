{
    "name": "arm092/laravel-translation",
    "description": "A tool for managing all of your Laravel 10+ translations",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Joe Dixon",
            "email": "hello@joedixon.co.uk"
        },
        {
            "name": "Arman Khachatryan",
            "email": "arman.khachatryan@apricode.am"
        }
    ],
    "require": {
        "php": "^8.1",
        "illuminate/support": "^10.0||^11.0||^12.0||^13.0"
    },
    "require-dev": {
        "mockery/mockery": "^1.6.10",
        "orchestra/testbench": "^8.0||^9.0||^10.0||^11.0",
        "phpunit/phpunit": "^10.5.62||^11.5.50||^12.5.8||^13.0.3"
    },
    "autoload": {
        "psr-4": {
            "JoeDixon\\Translation\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "JoeDixon\\Translation\\Tests\\": "tests"
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit",
        "test-coverage": "vendor/bin/phpunit --coverage-html coverage"
    },
    "extra": {
        "laravel": {
            "providers": [
                "JoeDixon\\Translation\\TranslationServiceProvider",
                "JoeDixon\\Translation\\TranslationBindingsServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true
    }
}
